# ---------------------------------------------------------------------------
# VIBE4U backend configuration. Copy to server/.env and fill in real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Core ---
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Local mongod:  mongodb://127.0.0.1:27017/vibe4u
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vibe4u?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/vibe4u

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=vibe4u_token
# Set true only when serving over HTTPS
COOKIE_SECURE=false

# --- Google OAuth (optional) ---
# The client secret must live ONLY here, never in the frontend .env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# --- Razorpay ---
# Dashboard > Settings > API Keys. Leave blank to run the built-in sandbox gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (paise-free, plain rupees) ---
CONVENIENCE_FEE_PER_SEAT=25
GST_PERCENT_ON_FEE=18
MAX_SEATS_PER_BOOKING=10
SEAT_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=2
CANCELLATION_FEE_PERCENT=10

# --- Catalog seeding ---
# Optional TMDB key used by the seed script to import real movie metadata.
TMDB_API_KEY=

# --- Seed accounts (change before seeding anything public) ---
SEED_SUPER_ADMIN_EMAIL=admin@vibe4u.in
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_BRANCH_ADMIN_PASSWORD=Branch@12345
SEED_DEMO_USER_EMAIL=demo@vibe4u.in
SEED_DEMO_USER_PASSWORD=Demo@12345
